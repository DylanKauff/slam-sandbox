<?xml version="1.0" encoding="UTF-8" ?>
<!-- FastDDS profile: route all data over SHARED MEMORY instead of UDP loopback.
     Every DDS participant here lives in one container on one host (the browser
     dashboards talk HTTP/websocket, not DDS), so shared memory is always the
     right intra-host path. The default UDP-loopback transport let the large
     RELIABLE /nvblox_node/mesh topic flood the loopback and drop cuVSLAM's
     BEST_EFFORT stereo image packets -> multi-second frame gaps -> the room
     duplicated at an angle. SHM has no UDP buffer limit / fragmentation, so the
     mesh and images no longer contend. A 128 MB segment holds the growing mesh.
     UDP is kept only as a discovery fallback. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_transport</transport_id>
        <type>SHM</type>
        <segment_size>134217728</segment_size>
        <port_queue_capacity>4096</port_queue_capacity>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>udp_transport</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="shm_first" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_transport</transport_id>
          <transport_id>udp_transport</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
